{
  "$schema": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/verification/vortik-trusted-verification-requirements/1.3.0/schema.json",
  "requirements": "vortik-trusted-verification-requirements",
  "requirements_version": "1.3.0",
  "implementation_state": {
    "mode": "trusted_verifiers",
    "primary_source_verifier_implemented": true,
    "ens_mainnet_verifier_implemented": true,
    "live_network_access": true,
    "trusted_receipt_issuance": false
  },
  "primary_source_verification": {
    "required": true,
    "independent_retrieval_required": true,
    "authority_validation_required": true,
    "allowed_authority_classes": [
      "eip",
      "ethereum_spec",
      "ethereum_official_repository",
      "protocol_spec",
      "protocol_official_repository"
    ],
    "canonical_source_identifier_required": true,
    "repository_identity_required": true,
    "immutable_revision_required": true,
    "commit_sha_required": true,
    "blob_sha_required": true,
    "source_path_required": true,
    "content_digest_required": true,
    "content_digest_verified_against_asserted_artifact_required": true,
    "retrieved_bytes_bound_to_asserted_revision_required": true,
    "claim_binding_required": true,
    "contributor_reference_trusted": false
  },
  "ens_mainnet_verification": {
    "required": true,
    "chain_id": 1,
    "independent_lookup_required": true,
    "exact_normalized_name_binding_required": true,
    "block_number_required": true,
    "block_hash_required": true,
    "asserted_block_number_hash_binding_required": true,
    "finalized_block_required": true,
    "block_timestamp_required": true,
    "block_timestamp_bound_to_asserted_block_required": true,
    "max_block_age_seconds": 1800,
    "block_freshness_against_trusted_issued_at_required": true,
    "block_timestamp_not_after_trusted_issued_at_required": true,
    "lookup_result_digest_required": true,
    "lookup_result_bound_to_asserted_block_required": true,
    "lookup_result_digest_bound_to_asserted_block_required": true,
    "provider_identity_required": true,
    "affirmative_existence_result_required": true,
    "active_registration_result_required": true,
    "registration_expiry_required": true,
    "registration_expiry_bound_to_exact_normalized_name_required": true,
    "registration_expiry_bound_to_lookup_result_required": true,
    "registration_expiry_bound_to_asserted_block_required": true,
    "registration_expiry_after_block_timestamp_required": true,
    "registration_expiry_after_trusted_issued_at_required": true,
    "negative_null_or_indeterminate_result_rejected": true,
    "contributor_ens_claim_trusted": false,
    "ownership_inference": false
  },
  "receipt_integrity": {
    "verifier_identity_required": true,
    "verifier_version_required": true,
    "issuer_authentication_required": true,
    "issuer_key_identity_required": true,
    "signing_key_authorization_required": true,
    "signing_key_trust_policy_validation_required": true,
    "signature_required": true,
    "signature_validation_required": true,
    "signature_covers_receipt_digest_required": true,
    "complete_receipt_authentication_binding_required": true,
    "subject_contribution_digest_required": true,
    "candidate_name_required": true,
    "normalized_candidate_name_required": true,
    "receipt_digest_required": true,
    "issued_at_required": true,
    "trusted_issued_at_required": true,
    "trusted_clock_source_required": true,
    "trusted_clock_source_policy_validation_required": true,
    "trusted_issued_at_not_caller_controlled_required": true,
    "admission_valid_until_required": true,
    "max_admission_validity_seconds": 86400,
    "admission_valid_until_not_after_trusted_issued_at_plus_max_window_required": true,
    "admission_valid_until_not_after_registration_expiry_required": true,
    "replay_protection_required": true
  },
  "admission": {
    "enabled": false,
    "primary_source_receipt_required": true,
    "ens_mainnet_receipt_required": true,
    "both_receipts_required": true,
    "authenticated_receipts_required": true,
    "authorized_signing_key_required": true,
    "same_subject_binding_required": true,
    "freshness_validation_required": true,
    "trusted_admission_time_required": true,
    "trusted_admission_clock_source_required": true,
    "trusted_admission_clock_source_policy_validation_required": true,
    "trusted_admission_time_not_caller_controlled_required": true,
    "trusted_admission_time_not_before_trusted_issued_at_required": true,
    "freshness_validation_against_trusted_admission_time_required": true,
    "receipt_not_expired_at_admission_required": true,
    "receipt_not_expired_at_trusted_admission_time_required": true,
    "separate_registry_pr_required": true,
    "commercial_authority": false
  }
}
