{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/reviews/vortik-ens-candidate-review/1.0.0/schema.json",
  "title": "Vortik ENS Candidate Review 1.0.0",
  "description": "Closed review and provenance contract for assessing an external ENS candidate contribution while trusted Ethereum/protocol and ENS verification receipts remain unavailable. Review observations never create registry eligibility, mutate registry state, infer ownership, or grant commercial authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "review",
    "review_version",
    "review_id",
    "contribution_id",
    "contribution_digest",
    "candidate_name",
    "evidence_review",
    "decision",
    "gates"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/reviews/vortik-ens-candidate-review/1.0.0/schema.json"
    },
    "review": { "const": "vortik-ens-candidate-review" },
    "review_version": { "const": "1.0.0" },
    "review_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "contribution_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Canonical SHA-256 digest of the complete contribution artifact. The evaluator recomputes this value and rejects replay against changed claim-bearing fields."
    },
    "candidate_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "evidence_review": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "source_classification",
          "review_status",
          "supports_semantic_claim",
          "supports_ens_existence",
          "note"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "source_classification": {
            "enum": [
              "eip",
              "ethereum_spec",
              "ethereum_official_repository",
              "protocol_spec",
              "protocol_official_repository",
              "ens_onchain_claim",
              "implementation_repository",
              "research_discussion",
              "secondary_context"
            ],
            "description": "Reviewer classification only. This label is not an authority grant and cannot satisfy a promotion gate."
          },
          "review_status": {
            "enum": ["observed", "independently_reviewed", "rejected"],
            "description": "Review workflow status only. It is not a trusted verification receipt."
          },
          "supports_semantic_claim": { "type": "boolean" },
          "supports_ens_existence": { "type": "boolean" },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason"],
      "properties": {
        "outcome": {
          "enum": ["reject", "keep_backlog", "research_note"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reviewed_term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reviewed_classification": {
          "enum": ["core", "repairable", "premature", "external", "deprecated"]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trusted_primary_source_receipt_available",
        "trusted_ens_receipt_available",
        "contributor_input_trusted",
        "ownership_inferred",
        "commercial_authority",
        "registry_mutated",
        "registry_pr_eligible",
        "separate_registry_pr_required"
      ],
      "properties": {
        "trusted_primary_source_receipt_available": { "const": false },
        "trusted_ens_receipt_available": { "const": false },
        "contributor_input_trusted": { "const": false },
        "ownership_inferred": { "const": false },
        "commercial_authority": { "const": false },
        "registry_mutated": { "const": false },
        "registry_pr_eligible": { "const": false },
        "separate_registry_pr_required": { "const": true }
      }
    }
  }
}
