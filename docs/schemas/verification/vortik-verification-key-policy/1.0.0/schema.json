{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/verification/vortik-verification-key-policy/1.0.0/schema.json",
  "title": "Vortik Verification Key Policy 1.0.0",
  "description": "Closed public trust-policy format for authorizing Ed25519 receipt-verification keys. It contains public verification material only; private key material is not a valid field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "policy",
    "policy_version",
    "policy_id",
    "canonicalization",
    "digest_algorithm",
    "signature_algorithm",
    "authorized_keys"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/verification/vortik-verification-key-policy/1.0.0/schema.json"
    },
    "policy": {
      "const": "vortik-verification-key-policy"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-constrained-v1"
    },
    "digest_algorithm": {
      "const": "SHA-256"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "authorized_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "algorithm",
          "public_key_spki_der_base64",
          "status",
          "not_before",
          "not_after",
          "allowed_receipt_types"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "public_key_spki_der_base64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "minLength": 32,
            "maxLength": 512
          },
          "status": {
            "enum": [
              "active",
              "retired",
              "revoked"
            ]
          },
          "not_before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "not_after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "allowed_receipt_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "primary_source",
                "ens_mainnet"
              ]
            }
          }
        }
      }
    }
  }
}
