{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/verification/vortik-trusted-verification-requirements/1.2.0/schema.json",
  "title": "Vortik Trusted Verification Requirements 1.2.0",
  "description": "Closed requirements contract for the trusted verification bridge after bounded primary-source retrieval becomes implemented. It records bounded live GitHub retrieval as available while keeping ENS mainnet verification, trusted receipt issuance and candidate admission disabled, and preserves exact immutable evidence, authentication, clock, freshness and public/private trust requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "requirements",
    "requirements_version",
    "implementation_state",
    "primary_source_verification",
    "ens_mainnet_verification",
    "receipt_integrity",
    "admission"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/verification/vortik-trusted-verification-requirements/1.2.0/schema.json"
    },
    "requirements": {
      "const": "vortik-trusted-verification-requirements"
    },
    "requirements_version": {
      "const": "1.2.0"
    },
    "implementation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "primary_source_verifier_implemented",
        "ens_mainnet_verifier_implemented",
        "live_network_access",
        "trusted_receipt_issuance"
      ],
      "properties": {
        "mode": { "const": "primary_source_verifier" },
        "primary_source_verifier_implemented": { "const": true },
        "ens_mainnet_verifier_implemented": { "const": false },
        "live_network_access": { "const": true },
        "trusted_receipt_issuance": { "const": false }
      }
    },
    "primary_source_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "independent_retrieval_required",
        "authority_validation_required",
        "allowed_authority_classes",
        "canonical_source_identifier_required",
        "repository_identity_required",
        "immutable_revision_required",
        "commit_sha_required",
        "blob_sha_required",
        "source_path_required",
        "content_digest_required",
        "content_digest_verified_against_asserted_artifact_required",
        "retrieved_bytes_bound_to_asserted_revision_required",
        "claim_binding_required",
        "contributor_reference_trusted"
      ],
      "properties": {
        "required": { "const": true },
        "independent_retrieval_required": { "const": true },
        "authority_validation_required": { "const": true },
        "allowed_authority_classes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "eip",
              "ethereum_spec",
              "ethereum_official_repository",
              "protocol_spec",
              "protocol_official_repository"
            ]
          },
          "allOf": [
            { "contains": { "const": "eip" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "const": "ethereum_spec" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "const": "ethereum_official_repository" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "const": "protocol_spec" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "const": "protocol_official_repository" }, "minContains": 1, "maxContains": 1 }
          ]
        },
        "canonical_source_identifier_required": { "const": true },
        "repository_identity_required": { "const": true },
        "immutable_revision_required": { "const": true },
        "commit_sha_required": { "const": true },
        "blob_sha_required": { "const": true },
        "source_path_required": { "const": true },
        "content_digest_required": { "const": true },
        "content_digest_verified_against_asserted_artifact_required": { "const": true },
        "retrieved_bytes_bound_to_asserted_revision_required": { "const": true },
        "claim_binding_required": { "const": true },
        "contributor_reference_trusted": { "const": false }
      }
