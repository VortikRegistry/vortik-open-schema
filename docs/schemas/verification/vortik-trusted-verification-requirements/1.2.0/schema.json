        "authenticated_receipts_required": { "const": true },
        "authorized_signing_key_required": { "const": true },
        "same_subject_binding_required": { "const": true },
        "freshness_validation_required": { "const": true },
        "trusted_admission_time_required": { "const": true },
        "trusted_admission_clock_source_required": { "const": true },
        "trusted_admission_clock_source_policy_validation_required": { "const": true },
        "trusted_admission_time_not_caller_controlled_required": { "const": true },
        "trusted_admission_time_not_before_trusted_issued_at_required": { "const": true },
        "freshness_validation_against_trusted_admission_time_required": { "const": true },
        "receipt_not_expired_at_admission_required": { "const": true },
        "receipt_not_expired_at_trusted_admission_time_required": { "const": true },
        "separate_registry_pr_required": { "const": true },
