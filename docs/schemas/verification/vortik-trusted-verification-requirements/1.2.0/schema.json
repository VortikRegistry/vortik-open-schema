      "properties": {
        "required": { "const": true },
        "chain_id": { "const": 1 },
        "independent_lookup_required": { "const": true },
        "exact_normalized_name_binding_required": { "const": true },
        "block_number_required": { "const": true },
        "block_hash_required": { "const": true },
        "asserted_block_number_hash_binding_required": { "const": true },
        "finalized_block_required": { "const": true },
        "block_timestamp_required": { "const": true },
        "block_timestamp_bound_to_asserted_block_required": { "const": true },
        "max_block_age_seconds": { "const": 1800 },
        "block_freshness_against_trusted_issued_at_required": { "const": true },
        "block_timestamp_not_after_trusted_issued_at_required": { "const": true },
        "lookup_result_digest_required": { "const": true },
        "lookup_result_bound_to_asserted_block_required": { "const": true },
        "lookup_result_digest_bound_to_asserted_block_required": { "const": true },
        "provider_identity_required": { "const": true },
        "affirmative_existence_result_required": { "const": true },
        "active_registration_result_required": { "const": true },
        "registration_expiry_required": { "const": true },
        "registration_expiry_bound_to_exact_normalized_name_required": { "const": true },
        "registration_expiry_bound_to_lookup_result_required": { "const": true },
        "registration_expiry_bound_to_asserted_block_required": { "const": true },
        "registration_expiry_after_block_timestamp_required": { "const": true },
        "registration_expiry_after_trusted_issued_at_required": { "const": true },
        "negative_null_or_indeterminate_result_rejected": { "const": true },
        "contributor_ens_claim_trusted": { "const": false },
        "ownership_inference": { "const": false }
      }
    },
    "receipt_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_identity_required",
