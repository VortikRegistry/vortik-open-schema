        "primary_source_receipt_required",
        "ens_mainnet_receipt_required",
        "both_receipts_required",
        "authenticated_receipts_required",
        "authorized_signing_key_required",
        "same_subject_binding_required",
        "freshness_validation_required",
        "trusted_admission_time_required",
        "trusted_admission_clock_source_required",
        "trusted_admission_clock_source_policy_validation_required",
        "trusted_admission_time_not_caller_controlled_required",
        "trusted_admission_time_not_before_trusted_issued_at_required",
        "freshness_validation_against_trusted_admission_time_required",
        "receipt_not_expired_at_admission_required",
