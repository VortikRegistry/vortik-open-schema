        "signature_validation_required",
        "signature_covers_receipt_digest_required",
        "complete_receipt_authentication_binding_required",
        "subject_contribution_digest_required",
        "candidate_name_required",
        "normalized_candidate_name_required",
        "receipt_digest_required",
        "issued_at_required",
        "trusted_issued_at_required",
        "trusted_clock_source_required",
        "trusted_clock_source_policy_validation_required",
        "trusted_issued_at_not_caller_controlled_required",
        "admission_valid_until_required",
        "max_admission_validity_seconds",
        "admission_valid_until_not_after_trusted_issued_at_plus_max_window_required",
        "admission_valid_until_not_after_registration_expiry_required",
        "replay_protection_required"
      ],
      "properties": {
        "verifier_identity_required": { "const": true },
        "verifier_version_required": { "const": true },
        "issuer_authentication_required": { "const": true },
        "issuer_key_identity_required": { "const": true },
        "signing_key_authorization_required": { "const": true },
        "signing_key_trust_policy_validation_required": { "const": true },
        "signature_required": { "const": true },
        "signature_validation_required": { "const": true },
        "signature_covers_receipt_digest_required": { "const": true },
        "complete_receipt_authentication_binding_required": { "const": true },
        "subject_contribution_digest_required": { "const": true },
        "candidate_name_required": { "const": true },
        "normalized_candidate_name_required": { "const": true },
        "receipt_digest_required": { "const": true },
        "issued_at_required": { "const": true },
        "trusted_issued_at_required": { "const": true },
        "trusted_clock_source_required": { "const": true },
        "trusted_clock_source_policy_validation_required": { "const": true },
        "trusted_issued_at_not_caller_controlled_required": { "const": true },
        "admission_valid_until_required": { "const": true },
        "max_admission_validity_seconds": { "const": 86400 },
        "admission_valid_until_not_after_trusted_issued_at_plus_max_window_required": { "const": true },
        "admission_valid_until_not_after_registration_expiry_required": { "const": true },
        "replay_protection_required": { "const": true }
