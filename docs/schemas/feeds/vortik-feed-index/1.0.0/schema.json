{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/feeds/vortik-feed-index/1.0.0/schema.json",
  "title": "Vortik Feed Index 1.0.0",
  "description": "Versioned discovery index for public Vortik machine feeds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "index",
    "index_version",
    "registry",
    "feeds",
    "authority",
    "generated_from"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/feeds/vortik-feed-index/1.0.0/schema.json"
    },
    "index": {
      "const": "vortik-feed-index"
    },
    "index_version": {
      "const": "1.0.0"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "last_updated",
        "source_of_truth"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "source_of_truth": {
          "const": "schemas"
        }
      }
    },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "feed",
          "feed_version",
          "canonical_term",
          "classification",
          "status",
          "path",
          "public_url",
          "anchor_doc",
          "contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "feed": {
            "type": "string",
            "minLength": 1
          },
          "feed_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "canonical_term": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^feeds/[a-z0-9-]+\\.json$"
          },
          "public_url": {
            "type": "string",
            "format": "uri"
          },
          "anchor_doc": {
            "type": "string",
            "pattern": "^anchors/.+\\.md$"
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "id",
              "public_url"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^schemas/.+/schema\\.json$"
              },
              "id": {
                "type": "string",
                "format": "uri"
              },
              "public_url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_scope",
        "protocol_authority",
        "ens_authority",
        "note"
      ],
      "properties": {
        "registry_scope": {
          "const": "independent semantic registry"
        },
        "protocol_authority": {
          "const": false
        },
        "ens_authority": {
          "const": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generated_from": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
