{
  "$schema": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/agents/vortik-agent-discovery/1.4.0/schema.json",
  "manifest": "vortik-agent-discovery",
  "manifest_version": "1.4.0",
  "project": {
    "name": "Vortik Registry",
    "description": "Independent source-grounded semantic registry and deterministic research surface for selected Ethereum coordination terminology.",
    "repository": "https://github.com/VortikRegistry/vortik-open-schema",
    "public_site": "https://vortikregistry.github.io/vortik-open-schema/"
  },
  "interaction": {
    "mode": "a2a_preactivation",
    "a2a_implementation_available": true,
    "a2a_server": false,
    "live_network_ingress": false,
    "agent_card_published": false,
    "protocol_binding": "HTTP+JSON",
    "protocol_version": "1.0",
    "agent_card_path": "/.well-known/agent-card.json",
    "interface_path": "/a2a/v1",
    "public_base_url": null,
    "note": "The bounded read-only A2A discovery implementation exists in the repository, but no public Agent Card or Vortik-operated A2A ingress is active until the separate deployment and activation gate passes."
  },
  "capabilities": [
    {
      "id": "discover_vortik_feeds",
      "kind": "public_artifact",
      "description": "Discover and verify versioned public Vortik semantic feeds without hard-coding individual feed paths.",
      "local_entrypoint": "feeds/index.json",
      "public_entrypoint": "https://vortikregistry.github.io/vortik-open-schema/feeds/index.json",
      "contract": "schemas/feeds/vortik-feed-index/1.0.0/schema.json",
      "network_required_by_repository_runtime": false
    },
    {
      "id": "research_ens_semantics",
      "kind": "local_library",
      "description": "Evaluate an ENS-style name deterministically against canonical Vortik registry and coordination-surface artifacts.",
      "local_entrypoint": "lib/ens-research-client.mjs",
      "documentation": "docs/ens-research-client.md",
      "request_contract": "schemas/queries/vortik-ens-research-request/1.0.0/schema.json",
      "response_contract": "schemas/queries/vortik-ens-research-response/1.0.0/schema.json",
      "network_required_by_repository_runtime": false
    },
    {
      "id": "inbound_ens_research_contract",
      "kind": "public_contract",
      "description": "Describe the closed request and response contracts an external agent may prepare for Vortik ENS semantic research without advertising a live submission endpoint.",
      "request_contract": "schemas/queries/vortik-ens-research-request/1.0.0/schema.json",
      "response_contract": "schemas/queries/vortik-ens-research-response/1.0.0/schema.json",
      "public_request_contract": "https://vortikregistry.github.io/vortik-open-schema/schemas/queries/vortik-ens-research-request/1.0.0/schema.json",
      "public_response_contract": "https://vortikregistry.github.io/vortik-open-schema/schemas/queries/vortik-ens-research-response/1.0.0/schema.json",
      "local_execution_entrypoint": "lib/ens-research-client.mjs",
      "submission_available": false,
      "network_required_by_repository_runtime": false
    },
    {
      "id": "prepare_ens_candidate_contribution",
      "kind": "public_contract",
      "description": "Prepare and submit a closed ENS candidate contribution artifact through the repository's GitHub Issue collaboration path for conservative Vortik review.",
      "contract": "schemas/queries/vortik-ens-candidate-contribution/1.0.0/schema.json",
      "public_contract": "https://vortikregistry.github.io/vortik-open-schema/schemas/queries/vortik-ens-candidate-contribution/1.0.0/schema.json",
      "documentation": "docs/ens-candidate-contributions.md",
      "submission_available": true,
      "submission_transport": "github_issue",
      "submission_url": "https://github.com/VortikRegistry/vortik-open-schema/issues/new?template=ens-candidate-contribution.md",
      "automatic_promotion": false,
      "network_required_by_repository_runtime": false
    },
    {
      "id": "public_a2a_discovery_beacon",
      "kind": "local_service",
      "description": "Bounded read-only A2A discovery service that maps selected Ethereum coordination queries to allowlisted public Vortik artifacts without external retrieval or persistent tasks.",
      "local_entrypoint": "service/cloud-run-agent-beacon.mjs",
      "library_entrypoint": "lib/public-a2a-beacon.mjs",
      "http_entrypoint": "lib/public-a2a-http.mjs",
      "documentation": "docs/public-a2a-beacon.md",
      "protocol_binding": "HTTP+JSON",
      "protocol_version": "1.0",
      "agent_card_path": "/.well-known/agent-card.json",
      "interface_path": "/a2a/v1",
      "persistent_tasks": false,
      "external_retrieval": false,
      "network_required_by_repository_runtime": false
    }
  ],
  "authority": {
    "protocol_authority": false,
    "ens_authority": false,
    "ownership_inference": false,
    "commercial_authority": false,
    "note": "Vortik artifacts, discovery responses and external contributions provide independent semantic research inputs and do not define Ethereum protocol rules, ENS authority, ownership intent, or commercial relevance."
  },
  "trust_boundary": {
    "canonical_artifacts_only": true,
    "live_ens_resolution": false,
    "external_web_retrieval": false,
    "mcp_source_ingestion": false,
    "external_content_trusted": false,
    "arbitrary_outbound_network": false,
    "receipt_runtime_dependency": false,
    "dedicated_runtime_identity_required": true,
    "caller_selected_network_destinations": false,
    "note": "Caller content remains untrusted data. The A2A beacon is limited to deterministic discovery over allowlisted public Vortik references and requires a separate isolated runtime identity and deny-egress deployment boundary before live activation."
  }
}
