{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/queries/vortik-ens-research-response/1.0.0/schema.json",
  "title": "Vortik ENS Research Response 1.0.0",
  "description": "Closed public response contract for source-grounded ENS semantic research without authority, ownership, or action inferences.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "response",
    "response_version",
    "request_id",
    "query",
    "result",
    "authority"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/VortikRegistry/vortik-open-schema/main/schemas/queries/vortik-ens-research-response/1.0.0/schema.json"
    },
    "response": {
      "const": "vortik-ens-research-response"
    },
    "response_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_name",
        "submitted_name_truncated",
        "normalized_name"
      ],
      "properties": {
        "submitted_name": {
          "type": "string",
          "maxLength": 255,
          "description": "Exact submitted value when at most 255 characters; otherwise the first 255 characters."
        },
        "normalized_name": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 5,
              "maxLength": 255,
              "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+\\.eth$",
              "description": "Candidate accepted by the implementation normalization boundary. Structural validation is not sufficient; consumers must run the semantic integrity validator."
            },
            {
              "type": "null"
            }
          ]
        },
        "submitted_name_truncated": {
          "type": "boolean",
          "description": "True only when submitted_name is a bounded prefix of a longer rejected input."
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "registry_entry",
        "related_terms",
        "evidence",
        "limitations",
        "errors"
      ],
      "properties": {
        "state": {
          "enum": [
            "tracked_anchor",
            "related_terminology",
            "untracked",
            "invalid_input",
            "indeterminate"
          ]
        },
        "registry_entry": {
          "oneOf": [
            {
              "$ref": "#/$defs/registry_entry"
            },
            {
              "type": "null"
            }
          ]
        },
        "related_terms": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/related_term"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "errors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_scope",
        "protocol_authority",
        "ens_authority",
        "ownership_inference"
      ],
      "properties": {
        "registry_scope": {
          "const": "independent semantic registry"
        },
        "protocol_authority": {
          "const": false
        },
        "ens_authority": {
          "const": false
        },
        "ownership_inference": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "registry_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ens",
        "canonical_term",
        "classification",
        "status",
        "type",
        "schema_path",
        "anchor_doc"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "ens": {
          "type": "string",
          "minLength": 5,
          "maxLength": 255,
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+\\.eth$"
        },
        "canonical_term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "classification": {
          "enum": [
            "core",
            "repairable",
            "premature",
            "external",
            "deprecated"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "enum": [
            "primitive",
            "constraint",
            "external_actor",
            "external_mechanism",
            "coordination_surface",
            "misaligned_abstraction"
          ]
        },
        "schema_path": {
          "type": "string",
          "pattern": "^schemas/.+/schema\\.json$"
        },
        "anchor_doc": {
          "type": "string",
          "pattern": "^anchors/.+\\.md$"
        }
      }
    },
    "related_term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "relationship",
        "evidence_refs"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "relationship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "claim"
      ],
      "properties": {
        "kind": {
          "enum": [
            "registry",
            "primary_source",
            "vortik_interpretation"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "state": {
                "const": "tracked_anchor"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "query": {
            "properties": {
              "normalized_name": {
                "type": "string"
              },
              "submitted_name_truncated": {
                "const": false
              }
            }
          },
          "result": {
            "properties": {
              "registry_entry": {
                "$ref": "#/$defs/registry_entry"
              },
              "evidence": {
                "minItems": 1
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "state": {
                "const": "related_terminology"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "query": {
            "properties": {
              "normalized_name": {
                "type": "string"
              },
              "submitted_name_truncated": {
                "const": false
              }
            }
          },
          "result": {
            "properties": {
              "registry_entry": {
                "type": "null"
              },
              "related_terms": {
                "minItems": 1
              },
              "evidence": {
                "minItems": 1
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "state": {
                "const": "untracked"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "query": {
            "properties": {
              "normalized_name": {
                "type": "string"
              },
              "submitted_name_truncated": {
                "const": false
              }
            }
          },
          "result": {
            "properties": {
              "registry_entry": {
                "type": "null"
              },
              "related_terms": {
                "maxItems": 0
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "state": {
                "const": "invalid_input"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "query": {
            "properties": {
              "normalized_name": {
                "type": "null"
              }
            }
          },
          "result": {
            "properties": {
              "registry_entry": {
                "type": "null"
              },
              "related_terms": {
                "maxItems": 0
              },
              "evidence": {
                "maxItems": 0
              },
              "errors": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "state": {
                "const": "indeterminate"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "registry_entry": {
                "type": "null"
              },
              "errors": {
                "minItems": 1
              }
            }
          },
          "query": {
            "properties": {
              "submitted_name_truncated": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
